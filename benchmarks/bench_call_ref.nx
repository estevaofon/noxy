// Mutação in-place via ref: custo deve ficar neutro entre baseline e CoW.
func bump(data: ref int[], rounds: int) -> void
    let i: int = 0
    while i < length(*data) do
        data[i] = data[i] + rounds
        i = i + 1
    end
end

func main()
    let data: int[]
    let i: int = 0
    while i < 20000 do
        append(ref data, i)
        i = i + 1
    end
    let r: int = 0
    while r < 300 do
        bump(ref data, r)
        r = r + 1
    end
    let s: int = 0
    i = 0
    while i < length(data) do
        s = s + data[i]
        i = i + 1
    end
    print(f"CHECKSUM:{s}")
end

main()
