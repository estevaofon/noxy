// Custo de um EMPRÉSTIMO — `ref` para DENTRO de um contêiner (issue #83).
//
// Este caminho não tinha benchmark, e foi por isso que a correção do #83 pôde
// regredi-lo em ~2x sem que a suíte acusasse: todo `ref` que os benchmarks
// usavam era `ref <variável>` (referência de célula, `data: ref int[]`), que é
// outro mecanismo e não passa por aqui.
//
// Um empréstimo denota um LUGAR: o caminho raiz->contêiner é re-resolvido a
// cada acesso, unicizando e gravando de volta em cada nível. O custo cresce com
// a PROFUNDIDADE do caminho, então o benchmark tem os dois extremos.
struct Nivel3
    xs: int[]
end
struct Nivel2
    c: Nivel3
end
struct Nivel1
    b: Nivel2
end

func bump(r: ref int) -> void
    *r = *r + 1
end

func main()
    // Raso: um nível (`ref arr[0]`).
    let arr: int[] = [0, 0, 0, 0]
    let i: int = 0
    while i < 200000 do
        bump(ref arr[0])
        i = i + 1
    end

    // Fundo: quatro níveis (`ref root.b.c.xs[0]`), struct sobre struct sobre
    // struct sobre array.
    let root: Nivel1 = Nivel1(Nivel2(Nivel3([0, 0])))
    let j: int = 0
    while j < 200000 do
        bump(ref root.b.c.xs[0])
        j = j + 1
    end

    // Empréstimo ligado a um nome e escrito muitas vezes: isola o custo do
    // CAMINHAR, sem recriar a referência a cada volta.
    let r: ref int = ref root.b.c.xs[1]
    let k: int = 0
    while k < 200000 do
        *r = *r + 1
        k = k + 1
    end

    print(arr[0])
    print(root.b.c.xs[0])
    print(root.b.c.xs[1])
end

main()
