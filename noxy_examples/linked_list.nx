struct Node
    valor: int
    proximo: ref Node?
end

func _append(node: ref Node, valor: int)
    // Quem liga o no novo e o ULTIMO no existente, escrevendo no proprio
    // campo 'proximo'. O no novo precisa ser uma variavel (L-value) para
    // virar 'ref novo'. Um campo 'ref' nulo passado adiante chega como ref
    // nula ('node == null'), nao como "slot vazio para preencher".
    if node.proximo == null then
        let novo: Node = Node(valor, null)
        node.proximo = ref novo
    else
        _append(node.proximo, valor)
    end
end


func pop(node: ref Node) -> int
    if node == null || node.proximo == null then
        return -1
    end
    let current: ref Node = node
    while current.proximo != null && current.proximo.proximo != null do
        current = current.proximo
    end
    let ultimo: ref Node? = current.proximo
    if ultimo == null then
        return -1
    end
    let valor: int = ultimo.valor
    current.proximo = null
    return valor
end


func pop_front(head: ref Node) -> int
    if head == null then
        return -1
    end
    let valor: int = head.valor

    if head.proximo == null then
        // lista tinha 1 elemento: devolve o valor
        // e você decide fora daqui como sinalizar "lista vazia"
        return valor
    end

    // copia dados do próximo para o atual e pula o próximo
    let prox: ref Node = head.proximo
    head.valor = prox.valor
    head.proximo = prox.proximo
    return valor
end
    

let no1: Node = Node(10, null)
_append(ref no1, 20)
_append(ref no1, 30)
_append(ref no1, 40)
_append(ref no1, 50)
_append(ref no1, 60)
_append(ref no1, 70)
_append(ref no1, 80)
_append(ref no1, 90)
_append(ref no1, 100)

func print_list(node: ref Node)
    let current: ref Node? = node
    while current != null do
        let prox: ref Node? = current.proximo
        print(to_str(current.valor))
        current = prox
    end
end

let v: int = pop(ref no1)
pop(ref no1)
print_list(ref no1)
print("Valor retornado "+to_str(v))
let z: int = pop_front(ref no1)
print("Valor retornado "+to_str(z))
print_list(ref no1)
