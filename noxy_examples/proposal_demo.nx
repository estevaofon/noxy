// Leitura e escrita explicitas de ref (spec 2026-08-24-explicit-ref, R2/R6)
// Objetivo: Tornar structs seguras e consistentes (evitando crashes).

struct Box
    val: ref int
end

let g: int = 100
let b: Box = Box(ref g)

// ---------------------------------------------------------
// 1. EXPRESSIONS (Uso do Valor)
// ---------------------------------------------------------
print("--- TEST 1: EXPRESSIONS ---")

// [CURRENT BEHAVIOR]
// O compilador não sabe que 'b.val' é uma referência.
// Ele passa o objeto-ponteiro direto para a soma.
// RESULTADO: Runtime Error (Panic no VM).
// let x: int = b.val + 1 

let x: int = *b.val + 1
print("Expression Result (100+1): %v", x)

// [IMPLEMENTADO: LEITURA EXPLICITA]
// O compilador sabe que 'val' e 'ref int', mas NAO insere OP_DEREF
// automaticamente (uma ref nunca e lida implicitamente). E preciso
// escrever '*b.val' para ler o valor apontado.
// RESULTADO: Sucesso (100 + 1 = 101).


// ---------------------------------------------------------
// 2. TYPE SAFETY (Atribuição Incorreta)
// ---------------------------------------------------------
print("--- TEST 2: TYPE SAFETY ---")

// [CURRENT BEHAVIOR]
// O compilador aceita atribuir 'int' direto num campo 'ref int'.
// Isso "sobrescreve" o ponteiro com um número cru.
// RESULTADO: A Struct fica corrompida. O tipo muda em runtime de Ref para Int.
// b.val = 500  // Compila, mas quebra o contrato da struct.

//b.val = 500
//print("b.val: %v", b.val)

// [IMPLEMENTADO: R6 — UPDATE vs REBIND SAO SINTATICOS, NUNCA INFERIDOS]
// O compilador rejeita a atribuicao direta de um 'int' cru a um campo 'ref int':
// nao existe inferencia pelo tipo do RHS. Escreva '*b.val = 500' para UPDATE
// (grava no alvo) ou 'b.val = ref outra_var' para REBIND (aponta para outro slot).
// RESULTADO: Compile Error! "cannot assign int to ref int"
//   hint: to point the field at a new value, bind it to a variable first and
//   use 'b.val = ref novo'; to overwrite the referenced value use '*b.val = ...'


// ---------------------------------------------------------
// 3. REBINDING vs UPDATE
// ---------------------------------------------------------
print("--- TEST 3: UPDATE ---")

let g2: int = 200

b.val = ref g2
print(fmt("b.val: %v", *b.val))

// [CURRENT BEHAVIOR]
// b.val = ref g2
// Isso altera o PONTEIRO (b.val agora aponta para g2).

// [IMPLEMENTADO: R6 — UPDATE E REBIND SAO SINTAXES DISTINTAS]
// Nao ha "Type-Based Assignment": o compilador nunca decide update vs rebind
// olhando o tipo do RHS. A sintaxe escolhida e' que decide, sempre:

// A) ATUALIZAR VALOR (Update) - requer '*' explicito no alvo
// '*b.val = 300' escreve 300 no slot apontado (equivale a '*r = v' em locais).
// *b.val = 300     // UPDATE: escreve no slot apontado por b.val
// print(g2)        // Imprime 300 (valor original alterado)

// B) REBIND PONTEIRO (Rebind) - requer 'ref' explicito no RHS
// 'b.val = ref g2' troca o ALVO do campo (equivale a 'r = ref y' em locais).
// b.val = ref g2   // REBIND: b.val passa a apontar para g2
// print(*b.val)    // Agora le' g2 (200)

// C) MISTURAR AS DUAS E' ERRO: '*b.val = ref g2' nao compila.
// Compiler error: "cannot assign ref int to int through '*r'"
//   hint: use 'r = ref z' to rebind the reference, or '*r = z' to write the value

// VANTAGEM:
// - Sem ambiguidade: a sintaxe ('*' ou 'ref') e' que decide, nunca o tipo do RHS
// - Consistente entre locais e campos: mesmas regras R2/R6 nos dois casos
// - Resolve o bug de corrupcao original (nao ha mais atribuicao direta de int
//   cru a um campo ref; ela e' rejeitada em tempo de compilacao)
