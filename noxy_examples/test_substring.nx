// test_substring.nx — Comprehensive substring semantics tests
use strings select *
use sys select *

let passed: int = 0
let failed: int = 0

func ok(name: string, got: string, want: string) -> void
    if got == want then
        passed = passed + 1
    else
        print("FAIL: " + name + " | got=" + got + " want=" + want)
        failed = failed + 1
    end
end

print("=== SUBSTRING TESTS ===")

// --- Basic: end_idx is exclusive ---
ok("basic 0:2",       substring("Hello", 0, 2), "He")
ok("basic 1:4",       substring("Hello", 1, 4), "ell")
ok("basic 0:5 full",  substring("Hello", 0, 5), "Hello")
ok("basic 2:3 single",substring("Hello", 2, 3), "l")

// --- Clamping: out-of-bounds indices are silently clamped ---
ok("clamp end>len",   substring("Hello", 3, 100), "lo")
ok("clamp start>len", substring("Hello", 99, 100), "")
ok("clamp both>len",  substring("abc", 10, 20), "")

// --- Empty results ---
ok("start==end",      substring("Hello", 2, 2), "")
ok("start>end",       substring("Hello", 4, 1), "")
ok("empty string",    substring("", 0, 5), "")

// --- Negative indices: Python-style (count from end) ---
ok("neg start -2",    substring("Hello", -2, 5), "lo")
ok("neg start -1",    substring("Hello", -1, 5), "o")
ok("neg end -1",      substring("Hello", 0, -1), "Hell")
ok("neg end -2",      substring("Hello", 0, -2), "Hel")
ok("both neg -3:-1",  substring("Hello", -3, -1), "ll")
ok("both neg -4:-2",  substring("Hello", -4, -2), "el")
ok("neg overflow",    substring("Hello", -100, 3), "Hel")

// --- Unicode: operates on runes, not bytes ---
let emoji: string = "aé🙂z"
// runes: a(0) é(1) 🙂(2) z(3)
ok("unicode 1:3",     substring(emoji, 1, 3), "é🙂")
ok("unicode 0:1",     substring(emoji, 0, 1), "a")
ok("unicode 2:4",     substring(emoji, 2, 4), "🙂z")
ok("unicode -1:4",    substring(emoji, -1, 4), "z")
ok("unicode 0:-1",    substring(emoji, 0, -1), "aé🙂")

// --- Practical patterns ---
let path: string = "/api/users/42"
// Extract after prefix: substring(s, prefix_len, length(s))
ok("after prefix",    substring(path, 11, length(path)), "42")
// Extract last N chars: substring(s, -N, length(s))
ok("last 2 chars",    substring(path, -2, length(path)), "42")
// Remove last char
ok("drop last",       substring(path, 0, -1), "/api/users/4")

// --- Report ---
print("")
print("=== RESULTS ===")
print("Passed: " + to_str(passed))
print("Failed: " + to_str(failed))

if failed > 0 then
    print("SOME TESTS FAILED")
    sys_exit(1)
end

print("ALL SUBSTRING TESTS PASSED")
