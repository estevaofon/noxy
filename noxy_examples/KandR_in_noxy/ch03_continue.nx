// processa só os elementos não negativos de a: continue pula para a próxima iteração
let a: int[] = [3, -1, 4, -1, 5, -9, 2, 6]
let sum: int = 0
for x in a do
    if x < 0 then
        continue            // pula os negativos
    end
    sum = sum + x           // o resto do corpo só roda para x >= 0
end
print(sum)
