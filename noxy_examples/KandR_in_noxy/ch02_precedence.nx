print(2 + 3 * 4, (2 + 3) * 4)
print(1 << 1 + 2)            // 8: o + vem antes do <<, como em C
print((1 & 3) == 1)          // os parênteses são necessários: & fica abaixo de ==

func f() -> int
    print("f")
    return 1
end
func g() -> int
    print("g")
    return 2
end
print(f() + g())              // a ordem é definida: da esquerda para a direita
