print(type(42), type(3.14), type(true), type("texto"), type(b"bytes"))

let max: int = 9223372036854775807
print(max)
print(max + 1)            // estoura e "dá a volta", como em C

print(length("café"), length(to_bytes("café")))   // caracteres vs. bytes
print(1 / 3.0)
print(0.1 + 0.2 == 0.3)   // ponto flutuante continua sendo ponto flutuante

let b: bytes = b"AB"
print(b[0], b[1])          // indexar bytes dá o valor numérico do byte
print("AB"[0], "AB"[1])    // indexar uma string dá uma string de 1 caractere
