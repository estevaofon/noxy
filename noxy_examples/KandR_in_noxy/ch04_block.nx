let x: int = 10
if x > 0 then
    let x: string = "interna"   // variável nova, esconde a externa até o end
    print(x)
end
print(x)

func outer() -> int
    let total: int = 0
    func add(n: int)            // função aninhada: enxerga 'total'
        total = total + n
    end
    add(3)
    add(4)
    return total
end
print(outer())
