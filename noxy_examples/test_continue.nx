// continue em while e for (#56 item 9)
use sys select exit

func assert(condition: bool, message: string) -> void
    if !condition then
        print("test_continue: FAIL - " + message)
        exit(1)
    end
end

let impares: int[] = []
let i: int = 0
while i < 10 do
    i = i + 1
    if i % 2 == 0 then continue end
    append(impares, i)
end
assert(length(impares) == 5, "5 impares")
assert(impares[4] == 9, "ultimo impar = 9")

let soma: int = 0
for n in [1, 2, 3, 4, 5, 6] do
    let dobro: int = n * 2
    if dobro % 4 == 0 then continue end
    soma = soma + dobro
end
assert(soma == 2 + 6 + 10, "soma dos dobros nao multiplos de 4")
print("continue ok")
