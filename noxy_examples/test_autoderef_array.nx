// Leitura explicita: r e a referencia, *r e o valor (spec 2026-08-24-explicit-ref)

func append_copy(i: ref int[]) -> int[]
    append(i, 1)
    return *i // Leitura explicita: '*i' converte ref int[] -> int[] (copia)
end

let a: int[] = [1, 2]
print("Original a:", a)

let b: int[] = append_copy(ref a)
// 'a' passada por ref a append_copy. 'a' vira [1, 2, 1] dentro.
// 'b' recebe COPIA de 'a' (valor lido via '*i').

print("After append_copy(a)")
print("a:", a) // Should be [1, 2, 1]
print("b:", b) // Should be [1, 2, 1]

append(ref b, 3)
// Modify 'b'. Since 'b' is a copy (value), 'a' should NOT change.

print("After append(b, 3)")
print("a:", a) // Should still be [1, 2, 1]
print("b:", b) // Should be [1, 2, 1, 3]

if length(a) == 3 && length(b) == 4 then
    print("SUCCESS: leitura explicita com '*i' funcionou")
else
    print("FAILURE: References leaked or copy failed")
end
