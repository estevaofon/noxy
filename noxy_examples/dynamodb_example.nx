use errors select *
use sys
use github_com.estevaofon.noxy_dynamodb as dynamodb

// ==========================================
// DynamoDB Example: CRUD Operations
// ==========================================

func main() -> void
    print("--- DynamoDB Example ---")

    // 1. Connection
    // Credentials come from the environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
    // ~/.aws/credentials, or an IAM role); "region" overrides AWS_REGION.
    // connect raises when the AWS configuration cannot be loaded (unknown option,
    // missing profile). Credentials are only exercised by the first request, so an
    // authentication failure shows up in put_item (false) / get_item (raises).
    let options: map[string, any] = {
        "region": "us-east-1"
    }

    let conn = call_result(dynamodb.connect, options)
    if !conn.ok then
        print(f"Error: Could not initialize DynamoDB client: {conn.failure.message}")
        sys.exit(1)
    end
    let client: dynamodb.Client = conn.value

    print(f"Connected. Client handle: {client.handle}")

    let TABLE_NAME: string = "mynotes_users"
    let USER_ID: string = "user_example_001"

    // 2. Create (Put Item)
    let newUser: map[string, any] = {
        "id": USER_ID,
        "name": "Jane Doe",
        "email": "jane@example.com",
        "age": 30,
        "active": true,
        "tags": ["new", "verified"]
    }

    print(f"Creating user {USER_ID}...")
    let created: bool = dynamodb.put_item(client, TABLE_NAME, newUser)
    if created then
        print("User created successfully.")
    else
        print("Failed to create user.")
    end

    // 3. Read (Get Item)
    // get_item returns null when the key does not exist and raises on failure
    // (unknown table, credentials); numbers come back as float.
    let key: map[string, any] = {
        "id": USER_ID
    }

    print(f"Reading user {USER_ID}...")
    let user: map[string, any]? = dynamodb.get_item(client, TABLE_NAME, key)

    if user != null then
        print(f"Found user: {user['name']} (Email: {user['email']}, Age: {user['age']})")
    else
        print("User not found.")
    end

    // 4. Update (Update Item)
    let updateExpr: string = "SET age = :newAge, active = :isActive"
    let exprVals: map[string, any] = {
        ":newAge": 31,
        ":isActive": false
    }

    print(f"Updating user {USER_ID}...")
    let updated: bool = dynamodb.update_item(client, TABLE_NAME, key, updateExpr, exprVals)

    if updated then
        print("User updated successfully.")
        let updatedUser: map[string, any]? = dynamodb.get_item(client, TABLE_NAME, key)
        if updatedUser != null then
            print(f"Updated Data -> Age: {updatedUser['age']}, Active: {updatedUser['active']}")
        end
    else
        print("Failed to update user.")
    end

    dynamodb.close(client)
end

main()
