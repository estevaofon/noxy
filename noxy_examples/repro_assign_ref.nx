struct Node
    next: ref Node?
end

let n: Node = Node(null)
let current: ref Node = ref n

// Setup next
let next_node: Node = Node(null)
current.next = ref next_node

// Test Rebind (spec §2.4: current.next is 'ref Node?', test before rebinding)
if current.next != null then
    current = current.next
end
print("Rebind successful")
