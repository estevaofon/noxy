struct Stack<T>
    items: T[]
end

// append(arr, val)
// pop(arr)

func push<T>(_stack: ref Stack<T>, value: T) -> void
    append(ref _stack.items, value)
    print(_stack.items)
end

func pop_stack<T>(_stack: ref Stack<T>) -> T
    return pop(ref _stack.items)
end

func print_stack<T>(_stack: Stack<T>) -> T[]
    let reversed_list: T[] = []
    let original_list: T[] = _stack.items
    while length(original_list) >= 1 do
        append(ref reversed_list, pop(ref original_list))
    end
    return reversed_list
end


let stack: Stack<int> = Stack([])
let stack_str: Stack<string> = Stack([])

push(ref stack, 1)
push(ref stack, 2)
print("Imprime pilha -> " + to_str(print_stack(stack)))
print("valor poped "+to_str(pop_stack(ref stack)))
print("valor poped "+to_str(pop_stack(ref stack)))


push(ref stack_str, "hello")
push(ref stack_str, "world")
print("Imprime pilha -> " + to_str(print_stack(stack_str)))
