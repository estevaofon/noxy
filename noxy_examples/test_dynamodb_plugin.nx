use errors select *
use github_com.estevaofon.noxy_dynamodb as dynamodb

print("--- DynamoDB Extension Test ---")

func main() -> void
    print("1. Connecting...")
    // This options map is passed to the extension. Credentials come from the
    // environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ~/.aws, IAM role).
    let options: map[string, any] = {
        "region": "us-east-1"
    }

    // connect raises when the AWS configuration cannot be loaded (unknown
    // option, missing profile); credentials are only checked by the first
    // request, i.e. by put_item below.
    let conn = call_result(dynamodb.connect, options)
    if !conn.ok then
        print(f"FAILED: Client creation failed: {conn.failure.message}")
        return
    end
    let client: dynamodb.Client = conn.value
    print(f"Client handle: {client.handle}")

    print("2. Putting Item...")
    let item: map[string, any] = {
        "id": "123",
        "name": "Noxy User",
        "active": true
    }

    let ok: bool = dynamodb.put_item(client, "mynotes_users", item)
    if ok then
        print("SUCCESS: Put item successful")
    else
        print("FAILED: Put item failed (Expected if no AWS creds)")
    end

    dynamodb.close(client)
end

main()
print("--- Test Finished ---")
