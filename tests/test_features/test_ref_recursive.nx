// Test recursive ref assignment like in merge

struct Node
    data: int,
    next: ref Node?
end

let n1: Node = Node(1, null)
let n2: Node = Node(2, null)
let n3: Node = Node(3, null)

n1.next = ref n2
n2.next = ref n3

func recursive_test(node: ref Node?) -> ref Node?
    if node == null then
        return null
    end
    let n: ref Node = node   // spec §2.4: o fato sobre 'node' (ref) morre na chamada a print
    print(n.data)
    // This is the pattern that mergesort uses:
    n.next = recursive_test(n.next)
    return n
end

print("Starting recursive test:")
let result: ref Node? = recursive_test(ref n1)
print("Done!")
