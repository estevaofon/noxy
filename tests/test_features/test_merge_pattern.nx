// Test the exact merge pattern

struct Node
    data: int,
    next: ref Node?
end

let n1: Node = Node(1, null)
let n2: Node = Node(2, null)
let n3: Node = Node(3, null)
let n4: Node = Node(4, null)

// Two separate lists:
// List 1: n1 -> n3 (1 -> 3)
// List 2: n2 -> n4 (2 -> 4)
n1.next = ref n3
n2.next = ref n4

func merge(l1: ref Node?, l2: ref Node?) -> ref Node?
    print("merge called")
    if l1 == null then
        print("l1 is null, returning l2")
        return l2
    end
    if l2 == null then
        print("l2 is null, returning l1")
        return l1
    end

    // spec §2.4: os fatos sobre l1/l2 (refs) morrem em cada chamada; vincula refs não-nulas
    let a: ref Node = l1
    let b: ref Node = l2
    print("l1.data=" + to_str(a.data) + " l2.data=" + to_str(b.data))

    if a.data < b.data then
        print("Going l1 path")
        a.next = merge(a.next, b)
        return a
    else
        print("Going l2 path")
        b.next = merge(a, b.next)
        return b
    end
end

print("Starting merge test:")
let result: ref Node? = merge(ref n1, ref n2)
print("Merge complete!")

// Print result
let current: ref Node? = result
while current != null do
    let next_node: ref Node? = current.next
    print(current.data)
    current = next_node
end
