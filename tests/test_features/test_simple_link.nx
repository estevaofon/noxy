// Simple linked list test - just 2 nodes

struct Node
    data: int,
    next: ref Node?
end

let n1: Node = Node(1, null)
let n2: Node = Node(2, null)

func print_list(head: ref Node)
    let current: ref Node? = head
    let count: int = 0
    while current != null && count < 10 do
        let next_node: ref Node? = current.next
        print(current.data)
        current = next_node
        count = count + 1
    end
end

// Test simple linking
print("Before link:")
print("n1:")
print_list(ref n1)
print("n2:")
print_list(ref n2)

// Link n1 to n2
n1.next = ref n2

print("After link n1->n2:")
print_list(ref n1)

// Now test modification via function
func modify(node: ref Node, new_next: ref Node?)
    node.next = new_next
end

// Unlink
modify(ref n1, null)
print("After modify(n1, null):")
print_list(ref n1)

// Link again
modify(ref n1, ref n2)
print("After modify(n1, n2):")
print_list(ref n1)
