// Trace merge with 2 linked lists

struct Node
    data: int,
    next: ref Node?
end

let n1: Node = Node(1, null)
let n2: Node = Node(2, null)
let n3: Node = Node(3, null)
let n4: Node = Node(4, null)

n1.next = ref n3
n2.next = ref n4

func merge(l1: ref Node?, l2: ref Node?, depth: int) -> ref Node?
    // spec §2.4: l1/l2 sao 'ref Node?'; so sao lidos depois dos testes de null
    // (antes, a leitura de l1.data com l1 == null derrubava o programa).
    if l1 == null then
        print("merge depth=" + to_str(depth) + " l1=null")
        print("  returning l2 (l1 null)")
        return l2
    end
    if l2 == null then
        print("merge depth=" + to_str(depth) + " l2=null")
        print("  returning l1 (l2 null)")
        return l1
    end
    let a: ref Node = l1   // os fatos sobre refs morrem em cada chamada; vincula refs nao-nulas
    let b: ref Node = l2
    print("merge depth=" + to_str(depth) + " l1=" + to_str(a.data) + " l2=" + to_str(b.data))

    if a.data < b.data then
        print("  l1 < l2, recursing with l1.next")
        let result: ref Node? = merge(a.next, b, depth + 1)
        print("  back at depth=" + to_str(depth) + ", setting l1.next")
        a.next = result
        print("  returning l1")
        return a
    else
        print("  l2 <= l1, recursing with l2.next")
        let result: ref Node? = merge(a, b.next, depth + 1)
        print("  back at depth=" + to_str(depth) + ", setting l2.next")
        b.next = result
        print("  returning l2")
        return b
    end
end

print("Calling merge:")
let result: ref Node? = merge(ref n1, ref n2, 0)
print("Merge complete!")
if result != null then
    print("Result data: " + to_str(result.data))
end
