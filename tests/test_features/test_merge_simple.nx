// Simplest merge test

struct Node
    data: int,
    next: ref Node?
end

let n1: Node = Node(1, null)
let n2: Node = Node(2, null)
let n3: Node = Node(3, null)
let n4: Node = Node(4, null)

n1.next = ref n3
n2.next = ref n4

func merge(l1: ref Node?, l2: ref Node?) -> ref Node?
    if l1 == null then
        return l2
    end
    if l2 == null then
        return l1
    end

    // spec §2.4: os fatos sobre l1/l2 (refs) morrem em cada chamada; vincula refs não-nulas
    let a: ref Node = l1
    let b: ref Node = l2
    print("merge: comparing")
    print(a.data)
    print(b.data)

    if a.data < b.data then
        print("l1 path")
        a.next = merge(a.next, b)
        return a
    else
        print("l2 path")
        b.next = merge(a, b.next)
        return b
    end
end

print("Starting")
let r: ref Node? = merge(ref n1, ref n2)
print("Done")
