// stdlib/convert.nx - Conversões numéricas verificáveis
//
// to_int e to_float levantam erro quando a conversão é impossível.
// Use as formas _result quando a falha for um dado esperado e não um bug:
// devolvem errors.Result<int> / Result<float> (spec §7, issue #105) —
// `if r.ok then` estreita r.value, `try to_int_result(s)` propaga a falha.

use errors select *

func to_int_result(v: any) -> Result<int>
    let raw: any = convert_to_int_result(v)
    if raw.ok then
        return Ok(raw.value)
    end
    return Err(raw.error)
end

func to_float_result(v: any) -> Result<float>
    let raw: any = convert_to_float_result(v)
    if raw.ok then
        return Ok(raw.value)
    end
    return Err(raw.error)
end
