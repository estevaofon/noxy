// errors.nx - O vocabulario unico de erro-como-dado (spec §7, issue #105).
//
// Failure descreve uma falha capturada (kind "runtime" | "panic", mensagem,
// stack e as falhas de defer agregadas em causes). Result<T> e o envelope
// tipado de toda operacao cuja falha e um resultado esperado: `ok` diz qual
// dos dois campos vale — em sucesso `value` e T e `failure` e o sentinela
// vazio; em falha `value` e null e `failure` descreve o erro. `if r.ok then`
// estreita `r.value` para T; `try expr` propaga a falha para o chamador.
//
// Construtoras: Ok(v), Err(msg), Fail(failure) — capitalizadas (precedente
// do antigo result.nx) para nao colidir com `let ok: bool` nos programas
// que importam a stdlib por select *.
//
// call_result(fn, ...args) devolve errors::Result<R>, com R o retorno
// estatico de fn (any quando desconhecido). Precisa deste modulo em escopo
// (`use errors select *`): o compilador entrega a instancia monomorfizada e
// o construtor de Failure a fronteira, que monta instancias reais.
//
// Referencia completa: docs/NOXY_LANGUAGE_SPEC.md, secao "Errors".

struct Failure
    kind: string       // "runtime" | "panic"; "" no sentinela de sucesso
    message: string
    stack: string
    causes: Failure[]  // falhas de defer agregadas no unwinding, ordem LIFO
end

struct Result<T>
    ok: bool
    value: T?          // T em sucesso (if r.ok then estreita), null em falha
    failure: Failure   // sentinela vazio em sucesso, nunca null
end

func empty_failure() -> Failure
    return Failure("", "", "", [])
end

func Ok<T>(value: T) -> Result<T>
    return Result(true, value, empty_failure())
end

func Err<T>(message: string) -> Result<T>
    return Result(false, null, Failure("runtime", message, "", []))
end

func Fail<T>(failure: Failure) -> Result<T>
    return Result(false, null, failure)
end
