use errors select *

struct File
    fd: int
    path: string
    mode: string
    open: bool
end

struct IOResult
    ok: bool
    data: string
    error: string
end

struct IOBytesResult
    ok: bool
    data: bytes
    error: string
end

struct IOWriteResult
    success: bool
    bytes_written: int
    error: string
end

struct IOCloseResult
    success: bool
    error: string
end

struct IOLinesResult
    ok: bool
    data: string[]
    error: string
end

struct FileInfo
    exists: bool
    size: int
    is_dir: bool
end

// Resultado de seek/tell: position é a posição absoluta (em bytes) do cursor
// lógico; -1 quando ok=false.
struct IOPositionResult
    ok: bool
    position: int
    error: string
end

// whence de seek, como o lseek de C: a partir do início, da posição atual
// ou do fim do arquivo.
let SEEK_SET: int = 0
let SEEK_CUR: int = 1
let SEEK_END: int = 2


// Wrappers para funções built-in (para uso com 'select *' como 'open(...)')

func open(path: string, mode: string) -> File
    return io_open(path, mode, File)
end

func stdin() -> File
    return io_stdin(File)
end

func close(file: File) -> void
    io_close(file)
end

// close_result / write_result / write_bytes_result (spec §7, issue #105):
// gemeas de close/write que devolvem errors.Result<T> em vez de levantar —
// IOCloseResult e IOWriteResult sao os shapes crus dos nativos.
func close_result(file: File) -> Result<bool>
    let raw: IOCloseResult = io_close_result(file, IOCloseResult)
    if raw.success then
        return Ok(true)
    end
    return Err(raw.error)
end

func read(file: File) -> IOResult
    return io_read(file, IOResult)
end

func read_line(file: File) -> IOResult
    return io_read_line(file, IOResult)
end

func read_bytes(file: File) -> IOBytesResult
    return io_read_bytes(file, IOBytesResult)
end

func read_lines(file: File) -> IOLinesResult
    return io_read_lines(file, IOLinesResult)
end

func write(file: File, content: string) -> void
    io_write(file, content)
end

func write_result(file: File, content: string) -> Result<int>
    let raw: IOWriteResult = io_write_result(file, content, IOWriteResult)
    if raw.success then
        return Ok(raw.bytes_written)
    end
    return Err(raw.error)
end

func exists(path: string) -> bool
    return io_exists(path)
end

func stat(path: string) -> FileInfo
    return io_stat(path, FileInfo)
end

func remove(path: string) -> bool
    return io_remove(path)
end

func rename(src: string, dst: string) -> bool
    return io_rename(src, dst)
end

func mkdir(path: string) -> bool
    return io_mkdir(path)
end

func list_dir(path: string) -> IOLinesResult
    return io_list_dir(path, IOLinesResult)
end

func write_bytes(file: File, data: bytes) -> void
    io_write(file, data)
end

func write_bytes_result(file: File, data: bytes) -> Result<int>
    let raw: IOWriteResult = io_write_result(file, data, IOWriteResult)
    if raw.success then
        return Ok(raw.bytes_written)
    end
    return Err(raw.error)
end

// Posicionamento (0.12.0): seek/tell movem e consultam o cursor lógico;
// read_n lê até n bytes a partir dele. read_line, read_n, write e as
// leituras de arquivo inteiro compõem com seek — ver spec §12.

func seek(file: File, offset: int, whence: int) -> IOPositionResult
    return io_seek(file, offset, whence, IOPositionResult)
end

func tell(file: File) -> IOPositionResult
    return io_tell(file, IOPositionResult)
end

func read_n(file: File, n: int) -> IOBytesResult
    return io_read_n(file, n, IOBytesResult)
end
