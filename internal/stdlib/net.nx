struct Socket
    fd: int
    addr: string
    port: int
    open: bool
end

struct NetResult
    ok: bool
    data: bytes
    count: int
    error: string
end

// SelectResult (spec §2.4, 0.22.0): os conjuntos prontos sao arrays
// DINAMICOS com exatamente read_count/write_count/error_count sockets —
// nenhum slot vazio, entao `result.read[i]` e um Socket (nunca null). Os
// conjuntos de ENTRADA (socket_set) continuam com 64 slots, e slot vazio e
// null: Socket?[64].
struct SelectResult
    read: Socket[]
    read_count: int
    write: Socket[]
    write_count: int
    error: Socket[]
    error_count: int
end



// Wrappers

func listen(host: string, port: int) -> Socket
    return net_listen(host, port)
end

func accept(server: Socket) -> Socket
    return net_accept(server)
end

func connect(host: string, port: int) -> Socket
    return net_connect(host, port)
end

func socket_recv(sock: Socket, size: int) -> NetResult
    return net_recv(sock, size)
end

func socket_send(sock: Socket, data: bytes) -> NetResult
    return net_send(sock, data)
end

func socket_close(sock: Socket) -> void
    net_close(sock.fd)
end

func setblocking(sock: Socket, blocking: bool) -> void
    net_setblocking(sock, blocking)
end

func settimeout(sock: Socket, timeout_ms: int) -> void
    net_settimeout(sock, timeout_ms)
end

func socket_set() -> Socket?[64]
    return net_socket_set()
end

func poll(read: Socket?[64], write: Socket?[64], err: Socket?[64], timeout: int) -> SelectResult
    let raw: any = net_select(read, write, err, timeout)
    let ready_read: Socket[] = []
    let ready_write: Socket[] = []
    let ready_error: Socket[] = []

    let i: int = 0
    while i < raw.read_count do
        let sock: any = raw.read[i]
        append(ref ready_read, Socket(sock.fd, sock.addr, sock.port, sock.open))
        i = i + 1
    end
    i = 0
    while i < raw.write_count do
        let sock: any = raw.write[i]
        append(ref ready_write, Socket(sock.fd, sock.addr, sock.port, sock.open))
        i = i + 1
    end
    i = 0
    while i < raw.error_count do
        let sock: any = raw.error[i]
        append(ref ready_error, Socket(sock.fd, sock.addr, sock.port, sock.open))
        i = i + 1
    end

    return SelectResult(ready_read, raw.read_count, ready_write, raw.write_count, ready_error, raw.error_count)
end
